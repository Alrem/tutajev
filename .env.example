# Tuta account credentials (used to log in directly to Tuta's API via the tutaproxy library).
TUTA_EMAIL=you@tuta.com
TUTA_PASSWORD=
# Base32 TOTP secret; only needed if 2FA (TOTP) is enabled. U2F/WebAuthn are not supported.
TUTA_TOTP_SECRET=

# Location of the tutaproxy checkout (see scripts/fetch_tutaproxy.sh).
TUTAPROXY_PATH=./vendor/tutaproxy
# Defensive: tutaproxy's telemetry module is never imported, but keep it disabled anyway.
TUTAPROXY_TELEMETRY=false

# Folders checked by default: system kinds (inbox, spam, trash, archive, sent) or custom
# folder names, comma-separated. List them with `tutajev --list-folders`.
TUTAJEV_FOLDERS=inbox

LOG_LEVEL=INFO

# Classification backend: jev (TypeSafe), clef or clef-flash (Cloudflare Workers AI).
TUTAJEV_CLASSIFIER=jev

# Jev (TypeSafe) API key; required when TUTAJEV_CLASSIFIER=jev.
TYPESAFE_API_KEY=
# Optional: pin a Jev model instead of the default "jev-latest".
# TYPESAFE_DEFAULT_MODEL=

# Cloudflare account id and an API token with Workers AI read permission;
# required when TUTAJEV_CLASSIFIER is clef or clef-flash.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
